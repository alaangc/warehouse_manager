{
  "name": "@warehouse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx ../../database/seeds/run.ts",
    "db:verify": "tsx ../../database/scripts/verify-migrations.ts",
    "db:recovery:test": "tsx ../../database/scripts/test-recovery.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@warehouse/contracts": "workspace:*",
    "argon2": "0.45.1",
    "decimal.js": "10.6.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "kysely": "0.29.5",
    "pdfkit": "0.20.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "26.4.0",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "testcontainers": "12.1.0"
  }
}
