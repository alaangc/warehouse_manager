{
  "name": "@warehouse/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "contract:generate": "node --experimental-strip-types scripts/generate-openapi.ts",
    "contract:lint": "redocly lint openapi.yaml",
    "contract:check": "node --experimental-strip-types scripts/check-contract.ts"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
