{
  "name": "@warehouse/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "contract:generate": "tsx scripts/generate-openapi.ts",
    "contract:lint": "redocly lint openapi.yaml",
    "contract:check": "tsx scripts/check-contract.ts",
    "contract:runtime": "tsx scripts/validate-runtime-contract.ts",
    "contract:compatibility": "tsx scripts/check-compatibility.ts",
    "contract:test": "tsx --test scripts/tests/*.test.ts"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "yaml": "2.9.1"
  }
}
