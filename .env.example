NODE_ENV=development
DATABASE_URL=postgres://warehouse_app:development-only@localhost:5432/warehouse_manager
SESSION_SECRET=replace-with-at-least-32-random-characters
# Production: exact IP/CIDR of the TLS proxy; unset means forwarded headers are ignored.
# TRUST_PROXY=127.0.0.1/32,::1/128
APP_ORIGIN=http://localhost:5173
BUSINESS_TIMEZONE=America/Hermosillo
BUSINESS_CURRENCY=MXN
PORT=3000
LOG_LEVEL=info
DOCUMENT_STORAGE_PATH=./var/documents
